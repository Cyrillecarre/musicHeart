{% extends 'base.html.twig' %}

{% block title %}Fiche de {{ participant.name }}{% endblock %}

{% block body %}
    <h1>Fiche du joueur</h1>
    <p><strong>Nom :</strong> {{ participant.name }}</p>
    <p><strong>Email :</strong> {{ participant.email }}</p>

    <h2>Vous êtes prêt à jouer ?</h2>
    <a href="{{ path('app_start_game', {'participantId': participant.id}) }}" class="btn btn-primary">Jouer</a>

{% endblock %}
