{% extends 'base.html.twig' %}

{% block title %}Message au participants{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/paiement.css') }}">
{% endblock %}

{% block body %}
    <div class="enteteTitre">
        <img class="logo" src="{{ asset('images/logoTM.png') }}" alt="logo">
        <h1 class="titre">Message aux Participants</h1>
    </div>
    <div class="message">
        <label for="prewrittenMessage">Message à envoyer au patient :</label>
        <p>Envoyer le message par mail à {{ patient.name }} à l'adresse: {{ patient.email }}</p>
        <div id="resultDisplay"></div>

        
<textarea id="prewrittenMessage" rows="14" cols="90" readonly class="textArea">
                Bonjour,

{{ admin.name }} à organiser un jeu pour vous ! 

Vous êtes invité à participer à Music Heart pour surmonter ce douloureux moment.

La date pour commencer à jouer est le {{ game.endDate ? game.endDate|date('d/m/Y H:i') : 'N/A' }} 
et la date maximum pour jouer est le {{ game.resultDate ? game.resultDate|date('d/m/Y H:i') : 'N/A' }}.

Lien pour participer : 
{{ patientLink }}

            Merci de votre participation !
        </textarea>
        <div class="buttonSend">
            <button onclick="envoyerEmail()" class="boutonEnregistrer">Envoyer le mail à {{ patient.name }}</button>
            <p>ou</p>
            <button onclick="copyMessage()" class="boutonEnregistrer">Cliquer pour copier et envoyer sur un autre canal</button>
        </div>
    </div>

    <div class="message">
        <label for="prewrittenMessage">Message à envoyer aux participants :</label>

<textarea id="prewrittenMessage2" rows="14" cols="90" readonly>
            Bonjour,

Vous êtes invité à participer à notre jeu Music Heart organisé par {{ admin.name }} 
Pour aider {{ patient.name }} à passer ce douloureux moment.

La date limite pour jouer est le {{ game.endDate ? game.endDate|date('d/m/Y H:i') : 'N/A' }} 
Les résultats seront affichés le {{ game.resultDate ? game.resultDate|date('d/m/Y H:i') : 'N/A' }}.
            
Lien pour les participants : 
{{ participantLink }}

            Merci de votre participation !
</textarea>
        <button onclick="copyMessage()" class="boutonEnregistrer">Cliquer pour copier le message, envoyez le par sms</button>
    </div>
    <div class="messageBas">
        <p>Ils vous reste plus qu'à partager à tout vos proches et de profiter du jeu</p>
    </div>

<script defer>
function envoyerEmail() {
    const adresseEmail = "{{ patient.email|e('js') }}";
    const message = document.getElementById('prewrittenMessage').value;

    fetch('/envoyer-email', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ adresseEmail, message })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('resultDisplay').innerHTML = '<p>Email envoyé avec succès</p>';
        } else {
            document.getElementById('resultDisplay').innerHTML = `<p>Erreur : ${data.error}</p>`;
        }
    })
    .catch(error => {
        document.getElementById('resultDisplay').innerHTML = `<p>Une erreur s'est produite : ${error.message}</p>`;
    });
}
</script>
{% endblock %}