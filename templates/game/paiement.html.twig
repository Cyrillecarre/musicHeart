{% extends 'base.html.twig' %}

{% block title %}paiement{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/paiement.css') }}">
{% endblock %}

{% block body %}
    <div class="enteteTitre">
        <img class="logo" src="{{ asset('images/logoTM.png') }}" alt="logo">
        <h1 class="titre">Page de paiement</h1>
    </div>

    <h2 class="titre2">Selectionnez votre mode de jeu :</h2>

    <div class="paiement">
        <button class="boutonEnregistrer">2 à 5 personnes : <br>FREE</button>
        <button class="boutonEnregistrer">6 à 10 personnes : <br>0,99€</button>
        <button class="boutonEnregistrer">11 personnes et plus : <br>1,99€</button>
    </div>

    <h2 class="titre2">Merci pour votre achat !</h2>
    <div class="message">
        <label for="prewrittenMessage">Message à envoyer au patient :</label>
        
<textarea id="prewrittenMessage" rows="14" cols="90" readonly class="textArea">
                Bonjour,

{{ admin.name }} à organiser un jeu pour vous ! 

Vous êtes invité à participer à Music Heart pour surmonter ce douloureux moment.

La date pour commencer à jouer est le {{ game.endDate ? game.endDate|date('d/m/Y H:i') : 'N/A' }} 
et la date maximum pour jouer est le {{ game.resultDate ? game.resultDate|date('d/m/Y H:i') : 'N/A' }}.

Lien pour participer : 
{{ patientLink }}

            Merci de votre participation !
        </textarea>
        <div class="buttonSend">
            <button onclick="sendSms()" class="boutonEnregistrer">Envoyer le SMS à {{ patient.name }}</button>
            <p>ou</p>
            <button onclick="copyMessage()" class="boutonEnregistrer">Copier le message et envoyer sur un autre canal</button>
        </div>
    </div>

    <div class="message">
        <label for="prewrittenMessage">Message à envoyer aux participants :</label>

<textarea id="prewrittenMessage2" rows="14" cols="90" readonly>
            Bonjour,

Vous êtes invité à participer à notre jeu Music Heart organisé par {{ admin.name }} 
Pour aider {{ patient.name }} à passer ce douloureux moment.

La date limite pour jouer est le {{ game.endDate ? game.endDate|date('d/m/Y H:i') : 'N/A' }} 
Les résultats seront affichés le {{ game.resultDate ? game.resultDate|date('d/m/Y H:i') : 'N/A' }}.
            
Lien pour les participants : 
{{ participantLink }}

            Merci de votre participation !
</textarea>
        <button onclick="copyMessage()" class="boutonEnregistrer">Copier le message et envoyez au participants par sms ou autre</button>
    </div>

<script>

function copyMessage() {
    var copyText = document.getElementById("prewrittenMessage");
    copyText.select();
    document.execCommand("copy");
    alert("Message copié !");
}
</script>
<script>
        function sendSms() {
            const numero = "{{ patient.phone }}";
            const message = document.getElementById('prewrittenMessage').value;

            fetch('/envoyer-sms', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ numero, message })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('SMS envoyé avec succès');
                } else {
                    alert('Erreur : ' + data.error);
                }
            })
            .catch(error => console.error('Erreur :', error));
        }
    </script>

{% endblock %}