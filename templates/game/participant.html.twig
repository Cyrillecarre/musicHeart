{% extends 'base.html.twig' %}

{% block title %}Configuration horaires{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/create_horaire.css') }}">
{% endblock %}

{% block body %}
    <div class="enteteTitre">
        <img class="logo" src="{{ asset('images/logoTM.png') }}" alt="logo">
        <h1 class="titre">Configurer les horaires de jeu</h1>
    </div>
    <div class="form">
    {{ form_start(gameForm, {'attr':{'class': 'formStart'}}) }}
        {{ form_row(gameForm.end_date, {'label': 'horaire de fin de participation pour les proches', 'attr': {'class': 'form-control datetime-picker'}}) }}
        {{ form_row(gameForm.result_date, {'label': 'horaire de fin de jeu du patient et affichage des résultat', 'attr': {'class': 'form-control datetime-picker'}}) }}
        {% if games is empty %}
            <button type="submit" class="boutonEnregistrer">Enregistrer les horaires</button>
        {% endif %}
    {{ form_end(gameForm) }}
    </div>
    {% if games is not empty %}
    <div>
        <ul>
            {% for game in games %}
            <div class="patient">
                <img class="patientLogo" src="{{ asset('images/patientLogo.png') }}" alt="patientLogo">
                <li class="patientName">{{ game.endDate|date('d/m/Y H:i') }}</li>
                <li class="patientPhone">{{ game.resultDate|date('d/m/Y H:i') }}</li>
                <button class="boutonEnregistrer2">
                    <a href="{{ path('edit_game', { id: game.id }) }}">Modifier les horaires</a>
                </button>
            </div>
            {% endfor %}
        </ul>
    </div>
        <button class="boutonEnregistrer">
            <a href="{{ path('app_paiement') }}">Message aux participants</a>
        </button>
    {% endif %}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const datePickers = document.querySelectorAll('.datetime-picker');

        datePickers.forEach(picker => {
            picker.addEventListener('focus', function() {
                this.showPicker();
            });
        });
    });
</script>
{% endblock %}