{% extends 'base.html.twig' %}

{% block title %}Bonjour{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/register.css') }}">
{% endblock %}

{% block body %}
    <div class="enteteTitre">
        <img class="logo" src="{{ asset('images/logoTM.png') }}" alt="logo" class="img">
        <h1 class="titre">Super ! 
        {% if app.user %}
            {{ app.user.name }}
        {% else %}
            Invité
        {% endif %}
        </h1>
    </div>

    {% if game %}
        <p>Vous avez déjà une partie en cours.</p>
        <p><a href="{{ path('app_game', { 'id': game.id }) }}">Accéder à la partie</a></p>
    {% else %}
    <div class="procedure">
        <h2>Vous êtes enregistré comme administrateur de la partie</h2>
        <button class="boutonEnregistrer"><a href="{{ path('create_patient') }}">Enregistrons le patient</a></button>
    </div>
    {% endif %}
{% endblock %}