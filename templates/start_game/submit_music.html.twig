{% extends 'base.html.twig' %}

{% block title %}Text soutient{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/choose.css') }}">
{% endblock %}

{% block body %}
    <div class="enteteTitre">
        <img class="logo" src="{{ asset('images/logoTM.png') }}" alt="logo">
        <h1 class="titre">Confirmer votre choix</h1>
    </div>

<h1>Confirmer votre choix</h1>

<p>Vous avez choisi la musique : {{ trackId }}</p>

<form method="post" action="{{ path('submit_music', { 'trackId': trackId }) }}">
    <label for="support_text">Message de soutien :</label>
    <textarea name="support_text" id="support_text"></textarea>

    <button type="submit">Soumettre</button>
</form>

{% endblock %}