{% extends 'base.html.twig' %}

{% block title %}Ajouter un texte de soutien{% endblock %}

{% block body %}
    <h1>Ajouter un texte de soutien</h1>
    <form method="post" action="{{ path('submit_music', { 'trackId': trackId, 'participantId': participant.id }) }}">
        <label for="support_text">Texte de soutien (facultatif) :</label>
        <textarea name="support_text" id="support_text" rows="4" cols="50"></textarea>
        <button type="submit">Soumettre</button>
    </form>
{% endblock %}