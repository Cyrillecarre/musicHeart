{% extends 'base.html.twig' %}

{% block title %}Choisir une musique{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/choose.css') }}">
{% endblock %}

{% block body %}
    <div class="enteteTitre">
        <img class="logo" src="{{ asset('images/logoTM.png') }}" alt="logo">
        <h1 class="titre">Choisir une musique</h1>
    </div>

    <form method="get" action="{{ path('choose_music',  { participantId: participant.id }) }}" class="form">
        <input type="text" name="query" value="{{ query|default('') }}" placeholder="Rechercher une musique" class="inputMusique">
        <button type="submit" class="boutonEnregistrer">Rechercher</button>
    </form>

    <div class="resultSpotify">
    {% for track in tracks %}
        <div class="card">
            <img src="{{ track.album.images[0].url }}" alt="Album cover" class="album-cover">
            <p class="track-info">{{ track.name }} - {{ track.artists[0].name }}</p>
            <a href="{{ path('submit_music', { trackId: track.id, participantId: participant.id }) }}" class="choose-button">
                Choisir cette musique
            </a>
        </div>
    {% else %}
        <p>Aucun résultat trouvé</p>
    {% endfor %}
</div>
{% endblock %}



